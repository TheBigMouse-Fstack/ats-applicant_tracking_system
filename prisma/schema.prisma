datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Users table (Nội bộ: Admin, HR, Hiring Manager)
model User {
  id            Int           @id @default(autoincrement())
  fullName      String
  email         String        @unique
  emailVerified Boolean       @default(true)
  image         String?
  phone         String?
  passwordHash  String        @default("")
  role          String        @default("HR") // ADMIN, HR, HIRING_MANAGER
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt

  jobs          Job[]
  evaluations   Evaluation[]
  auditLogs     AuditLog[]
  sessions      AuthSession[]
  accounts      AuthAccount[]

  @@map("users")
}

// 1b. Better Auth Sessions table (Server-side revocable sessions on Neon Postgres)
model AuthSession {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// 1c. Better Auth Accounts table (Credential provider linked to existing PBKDF2 hashes)
model AuthAccount {
  id                    Int       @id @default(autoincrement())
  userId                Int
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

// 1d. Better Auth Verification table
model AuthVerification {
  id         Int      @id @default(autoincrement())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verifications")
}

// 2. Jobs table (Vị trí tuyển dụng & Tiêu chuẩn JD)
model Job {
  id                 Int           @id @default(autoincrement())
  creatorId          Int
  creator            User          @relation(fields: [creatorId], references: [id])
  title              String
  department         String
  location           String        @default("Hồ Chí Minh")
  employmentType     String        @default("Toàn thời gian")
  requirementsJd      String
  minExperienceYears  Int           @default(0)
  requiredSkills      String        @default("[]") // JSON string: ["React", "TypeScript"]
  targetHeadcount     Int           @default(1) // Số lượng nhân sự cần tuyển (BRL-13)
  maxActiveInterviews Int           @default(3) // Trần số ứng viên phỏng vấn cùng lúc (mặc định 3x chỉ tiêu)
  screeningQuestions  String?       @default("[]") // BRL-16: JSON array [{ id, question, expectedAnswer, isKnockout }]
  status              String        @default("ACTIVE") // DRAFT, PENDING_APPROVAL, ACTIVE, CLOSED (BRL-17)
  approvedById        Int?          // BRL-17: ID người duyệt tin tuyển dụng (HM / Admin)
  approvedAt          DateTime?     // BRL-17: Thời điểm phê duyệt tin tuyển dụng
  approvalNote        String?       // BRL-17: Ghi chú phê duyệt hoặc lý do yêu cầu sửa
  createdAt           DateTime      @default(now())

  applications       Application[]

  @@index([status])
  @@index([creatorId])
  @@map("jobs")
}

// 3. Candidates table (Ứng viên & Khử trùng lặp)
model Candidate {
  id              Int           @id @default(autoincrement())
  fullName         String
  email            String
  phone            String
  cvExtractedName  String?       // Tên trích xuất từ CV (Secondary snapshot — không ghi đè Form)
  cvExtractedEmail String?       // Email trích xuất từ CV (Secondary snapshot)
  cvExtractedPhone String?       // SĐT trích xuất từ CV (Secondary snapshot)
  cvFileHash       String?       // SHA-256 hash của tệp CV gốc phục vụ phát hiện trùng lặp lớp 2
  experienceYears  Int           @default(0)
  parsedSkills    String?       @default("[]") // JSON string
  parsedEducation String?       @default("[]") // JSON string
  parsedExperience String?      @default("[]") // JSON string
  certificates    String?       @default("[]") // JSON string: [{ id, name, fileUrl, fileType, size, uploadedAt }]
  cvFileUrl       String
  cvText          String?       // Raw extracted text from PDF
  createdAt       DateTime      @default(now())

  applications    Application[]

  @@unique([email, phone]) // BRL-02 Deduplication key
  @@index([fullName])
  @@index([cvFileHash])
  @@map("candidates")
}

// 4. Applications table (Hồ sơ ứng tuyển theo Job & Kanban Pipeline)
model Application {
  id                 Int          @id @default(autoincrement())
  candidateId        Int
  candidate          Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId              Int
  job                Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  source             String       @default("CAREER_SITE") // CAREER_SITE, LINKEDIN, REFERRAL, HEADHUNTER, DIRECT_EMAIL, OTHER
  currentStage       String       @default("NEW") // NEW, SCREENING, INTERVIEW, OFFER, HIRED, REJECTED
  screeningAnswers   String?      @default("[]") // BRL-16: JSON array [{ questionId, question, answer, passed }]
  knockoutFailed     Boolean      @default(false) // BRL-16: Cờ cảnh báo chưa đạt câu hỏi sàng lọc cứng (Human-in-the-Loop)
  aiMatchScore       Float?       // 0.0 - 100.0%
  aiMatchRationale   String?      // Explanation why scored this %
  aiMatchedSkills    String?      @default("[]") // JSON string
  aiMissingSkills    String?      @default("[]") // JSON string
  stageUpdatedAt     DateTime     @default(now())
  emailScheduledAt   DateTime?    // BRL-05 Rejection delay buffer (+12h)
  isEmailSent        Boolean      @default(false)
  isInterviewInviteSent Boolean   @default(false) // Đã gửi Thư mời PV & Lịch Google Calendar hay chưa
  isTelegramNotified    Boolean   @default(false) // Đã bắn thông báo Telegram cho HR hay chưa
  repooledFromId     Int?
  isStarred          Boolean      @default(false) // Đánh dấu sao hồ sơ đặc biệt (như Gmail star)
  isViewed           Boolean      @default(false) // Đã được HR mở xem / xử lý hay chưa
  viewedAt           DateTime?    // Thời gian mở xem lần đầu
  interviewDate             DateTime?    // Lịch phỏng vấn đã xếp
  interviewFormat           String?      @default("ONLINE") // ONLINE, OFFLINE
  interviewLocation         String?      // Link Google Meet / Zoom hoặc Phòng họp thực tế
  interviewNotes            String?      // Ghi chú chuẩn bị cho ứng viên (Trước PV)
  interviewInterviewerNotes String?      // Ghi chú nội bộ cho chuyên gia / giám khảo (Trước PV)
  interviewPostNotes        String?      // Biên bản & ghi chú tổng kết sau phỏng vấn (Sau PV)
  interviewEmailOption      String       @default("AUTO_N8N") // AUTO_N8N, MANUAL_CUSTOM, NONE
  customEmailSubject        String?      // Tiêu đề email do HR tự soạn (nếu chọn MANUAL_CUSTOM)
  customEmailBody           String?      // Nội dung email do HR tự soạn / lưu trữ hồ sơ
  rejectionReason           String?      // BRL-11: Lý do từ chối bắt buộc khi chuyển sang REJECTED
  contactMismatchLevel      String       @default("NONE") // NONE, MINOR, CRITICAL, UNREADABLE (BRL-12)
  contactMismatchNote       String?      // Ghi chú lệch thông tin giữa Form đăng ký và tệp CV
  duplicateWarningAppId     Int?         // ID hồ sơ nghi ngờ trùng lặp (Lớp 2 Soft Flag - BRL-12)
  duplicateWarningNote      String?      // Ghi chú chi tiết nguyên nhân nghi ngờ trùng lặp
  createdAt                 DateTime     @default(now())

  evaluations        Evaluation[]
  auditLogs          AuditLog[]

  @@index([jobId, currentStage])
  @@index([currentStage, stageUpdatedAt])
  @@index([candidateId])
  @@index([isStarred])
  @@index([isViewed])
  @@index([isInterviewInviteSent])
  @@index([isTelegramNotified])
  @@index([interviewEmailOption])
  @@index([emailScheduledAt])
  @@map("applications")
}

// 5. Evaluations table (Phiếu chấm điểm phỏng vấn - Scorecard)
model Evaluation {
  id                  Int         @id @default(autoincrement())
  applicationId       Int
  application         Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  evaluatorId         Int
  evaluator           User        @relation(fields: [evaluatorId], references: [id])
  round               String?     @default("Vòng 1 — Đánh giá Chuyên môn")
  technicalScore      Int         // 1 - 5 (Trọng số 40%)
  communicationScore  Int         // 1 - 5 (Trọng số 30%)
  culturalFitScore    Int         // 1 - 5 (Trọng số 30%)
  overallScore        Float?      // Weighted average: (tech*0.4 + comm*0.3 + cult*0.3)
  recommendation      String      @default("HIRE") // STRONG_HIRE, HIRE, NO_HIRE, STRONG_NO_HIRE
  levelRecommendation String?     // TRAINEE, JUNIOR, MIDDLE, SENIOR, LEAD
  strengths           String?     // Điểm mạnh nổi bật — Lý do chính giúp ứng viên đạt chuẩn
  weaknesses          String?     // Điểm cần cải thiện / Rủi ro cần lưu ý
  technicalNotes      String?     // Đánh giá chi tiết chuyên môn / kỹ thuật
  communicationNotes  String?     // Đánh giá kỹ năng giao tiếp & thuyết trình
  cultureNotes        String?     // Đánh giá thái độ & văn hóa làm việc
  hireReason          String?     // Tóm tắt lý do quyết định tuyển dụng hoặc từ chối
  comments            String?     // Ghi chú tổng hợp
  createdAt           DateTime    @default(now())

  @@index([applicationId])
  @@index([evaluatorId])
  @@map("evaluations")
}

// 6. AuditLogs table (Lưu vết chuyển cột Kanban & thao tác hệ thống)
model AuditLog {
  id            Int          @id @default(autoincrement())
  applicationId Int
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId        Int?
  user          User?        @relation(fields: [userId], references: [id])
  fromStage     String?
  toStage       String
  action        String       // STAGE_CHANGE, CV_UPLOAD, SCORECARD_EVALUATE, PROFILE_EDITED
  reason        String?      // Lý do từ chối / Ghi chú chuyển trạng thái hoặc chỉnh sửa dữ liệu
  createdAt     DateTime     @default(now())

  @@index([applicationId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}
