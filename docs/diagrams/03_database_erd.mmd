erDiagram
    %% =========================================================================
    %% ATS — APPLICANT TRACKING SYSTEM DATABASE ERD (MERMAID)
    %% Chuẩn hóa 3NF, mô hình hóa quan hệ thực thể, khóa PK/FK và cờ tự động hóa
    %% =========================================================================

    USERS ||--o{ JOBS : "creates / manages"
    USERS ||--o{ EVALUATIONS : "scores (Scorecard)"
    USERS ||--o{ AUDIT_LOGS : "performs action"

    JOBS ||--o{ APPLICATIONS : "receives"
    CANDIDATES ||--o{ APPLICATIONS : "submits"

    APPLICATIONS ||--o{ EVALUATIONS : "evaluated by"
    APPLICATIONS ||--o{ AUDIT_LOGS : "tracked in"

    %% -------------------------------------------------------------------------
    %% 1. USERS (Tài khoản nội bộ: Admin, HR Lead, Hiring Manager)
    %% -------------------------------------------------------------------------
    USERS {
        int id PK "Khóa chính tự tăng"
        string full_name "Họ và tên người dùng"
        string email UK "Email đăng nhập nội bộ (Duy nhất)"
        string password_hash "Mật khẩu mã hóa BCrypt"
        string role "Vai trò: ADMIN | HR | HIRING_MANAGER"
        boolean is_active "Trạng thái tài khoản (true/false)"
        timestamp created_at "Thời điểm tạo tài khoản"
    }

    %% -------------------------------------------------------------------------
    %% 2. JOBS (Vị trí tuyển dụng & Tiêu chuẩn JD)
    %% -------------------------------------------------------------------------
    JOBS {
        int id PK "Khóa chính tin tuyển dụng"
        int creator_id FK "Tham chiếu USERS.id"
        string title "Tiêu đề vị trí công việc"
        string department "Phòng ban chuyên môn"
        string location "Địa điểm làm việc (Hồ Chí Minh)"
        string employment_type "Hình thức: Toàn thời gian | Bán thời gian"
        text requirements_jd "Mô tả yêu cầu công việc chi tiết"
        int min_experience_years "Số năm kinh nghiệm tối thiểu yêu cầu"
        string required_skills "Danh sách kỹ năng cốt lõi (JSON String)"
        int target_headcount "Chỉ tiêu số lượng nhân sự cần tuyển (BRL-13)"
        int max_active_interviews "Trần phỏng vấn cùng lúc (Mặc định 3x chỉ tiêu)"
        string status "Trạng thái tin: ACTIVE | CLOSED"
        timestamp created_at "Thời điểm đăng tin tuyển dụng"
    }

    %% -------------------------------------------------------------------------
    %% 3. CANDIDATES (Hồ sơ ứng viên & Khử trùng lặp định danh)
    %% -------------------------------------------------------------------------
    CANDIDATES {
        int id PK "Khóa chính hồ sơ ứng viên"
        string full_name "Họ và tên ứng viên (Source of Truth)"
        string email UK "Email ứng viên (Cặp trùng BRL-02)"
        string phone UK "Số điện thoại di động (Cặp trùng BRL-02)"
        string cv_extracted_name "Họ tên bóc tách từ file CV (Secondary)"
        string cv_extracted_email "Email bóc tách từ file CV (Secondary)"
        string cv_extracted_phone "SĐT bóc tách từ file CV (Secondary)"
        string cv_file_hash "SHA-256 hash phát hiện trùng tệp CV (BRL-12)"
        int experience_years "Số năm kinh nghiệm làm việc"
        string parsed_skills "Kỹ năng chuyên môn trích xuất (JSON String)"
        string parsed_education "Lịch sử học vấn trích xuất (JSON String)"
        string parsed_experience "Kinh nghiệm làm việc trích xuất (JSON String)"
        string certificates "Bằng cấp & chứng chỉ đính kèm (JSON String)"
        string cv_file_url "Đường dẫn lưu trữ tệp CV gốc (S3/Local)"
        text cv_text "Văn bản thô trích xuất từ CV phục vụ AI"
        timestamp created_at "Thời điểm khởi tạo hồ sơ ứng viên"
    }

    %% -------------------------------------------------------------------------
    %% 4. APPLICATIONS (Phiên ứng tuyển & Vòng đời Kanban 5 Cột)
    %% -------------------------------------------------------------------------
    APPLICATIONS {
        int id PK "Khóa chính phiên ứng tuyển"
        int candidate_id FK "Tham chiếu CANDIDATES.id"
        int job_id FK "Tham chiếu JOBS.id"
        string source "Nguồn nộp: CAREER_SITE | REFERRAL | HEADHUNTER"
        string current_stage "Vòng Kanban: NEW | SCREENING | INTERVIEW | HIRED | REJECTED"
        float ai_match_score "Điểm AI đối chiếu JD: 0.0 - 100.0%"
        text ai_match_rationale "Lý giải đánh giá và gợi ý từ AI Engine"
        string ai_matched_skills "Kỹ năng đạt yêu cầu JD (JSON String)"
        string ai_missing_skills "Kỹ năng còn thiếu so với JD (JSON String)"
        timestamp stage_updated_at "Thời điểm cập nhật trạng thái gần nhất"
        timestamp email_scheduled_at "Hẹn giờ gửi thư từ chối sau 12h (BRL-05)"
        boolean is_email_sent "Workflow 3: Đã gửi thư từ chối hay chưa"
        boolean is_interview_invite_sent "Workflow 1: Đã gửi thư mời PV & Lịch hẹn hay chưa"
        boolean is_telegram_notified "Workflow 2: Đã bắn tin Telegram cho HR hay chưa"
        int repooled_from_id "Tham chiếu phiên ứng tuyển cũ nếu được Re-pool"
        boolean is_starred "Đánh dấu sao ưu tiên đặc biệt"
        boolean is_viewed "Đã được HR mở xem chi tiết hay chưa"
        timestamp viewed_at "Thời điểm HR mở xem lần đầu"
        timestamp interview_date "Lịch hẹn phỏng vấn chính thức"
        string interview_format "Hình thức họp: ONLINE | OFFLINE"
        string interview_location "Link Google Meet / Zoom hoặc Phòng họp"
        text interview_notes "Ghi chú dặn dò cho ứng viên"
        text interview_interviewer_notes "Ghi chú nội bộ cho Hội đồng phỏng vấn"
        text interview_post_notes "Biên bản tổng kết sau phỏng vấn"
        string interview_email_option "Phương thức thư mời: AUTO_N8N | MANUAL_CUSTOM | NONE"
        string custom_email_subject "Tiêu đề email HR tự soạn lưu vết"
        text custom_email_body "Nội dung email HR tự soạn lưu vết"
        string rejection_reason "Lý do từ chối chuẩn hóa bắt buộc (BRL-11)"
        string contact_mismatch_level "Mức lệch thông tin Form vs CV: NONE | MINOR | CRITICAL"
        string contact_mismatch_note "Ghi chú lệch thông tin liên hệ"
        int duplicate_warning_app_id "ID hồ sơ nghi ngờ trùng lặp mềm (Lớp 2)"
        string duplicate_warning_note "Ghi chú chi tiết lý do cảnh báo trùng"
        timestamp created_at "Thời điểm nộp đơn ứng tuyển"
    }

    %% -------------------------------------------------------------------------
    %% 5. EVALUATIONS (Phiếu chấm điểm phỏng vấn - Scorecard 3 Tiêu chí)
    %% -------------------------------------------------------------------------
    EVALUATIONS {
        int id PK "Khóa chính phiếu đánh giá"
        int application_id FK "Tham chiếu APPLICATIONS.id"
        int evaluator_id FK "Tham chiếu USERS.id (Giám khảo chấm)"
        string round "Vòng phỏng vấn (Vòng 1 Chuyên môn)"
        int technical_score "Điểm Chuyên môn kỹ thuật (1-5, Trọng số 40%)"
        int communication_score "Điểm Kỹ năng giao tiếp (1-5, Trọng số 30%)"
        int cultural_fit_score "Điểm Độ phù hợp văn hóa (1-5, Trọng số 30%)"
        float overall_score "Điểm trung bình trọng số chuẩn (BRL-08)"
        string recommendation "Quyết định: STRONG_HIRE | HIRE | NO_HIRE | STRONG_NO_HIRE"
        string level_recommendation "Cấp bậc đề xuất: JUNIOR | MIDDLE | SENIOR | LEAD"
        text strengths "Điểm mạnh nổi bật của ứng viên"
        text weaknesses "Điểm cần cải thiện / Rủi ro cần lưu ý"
        text technical_notes "Nhận xét chi tiết chuyên môn kỹ thuật"
        text communication_notes "Nhận xét chi tiết giao tiếp & thuyết trình"
        text culture_notes "Nhận xét chi tiết thái độ & văn hóa"
        timestamp created_at "Thời điểm nộp phiếu đánh giá Scorecard"
    }

    %% -------------------------------------------------------------------------
    %% 6. AUDIT_LOGS (Nhật ký kiểm toán toàn vẹn & Lịch sử chuyển trạng thái)
    %% -------------------------------------------------------------------------
    AUDIT_LOGS {
        int id PK "Khóa chính nhật ký kiểm toán"
        int application_id FK "Tham chiếu APPLICATIONS.id"
        int user_id FK "Tham chiếu USERS.id (Người thao tác, null nếu do ứng viên)"
        string from_stage "Trạng thái trước khi chuyển (null nếu mới tạo)"
        string to_stage "Trạng thái đích sau khi chuyển"
        string action "Loại hành động: STAGE_CHANGE | CV_UPLOAD | SCORECARD_SUBMIT"
        text reason "Lý do chuyển trạng thái / Ghi chú kiểm toán (BRL-11)"
        timestamp created_at "Thời điểm ghi nhận hành động"
    }
