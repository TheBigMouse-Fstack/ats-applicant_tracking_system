# =========================================================================
# ATS — APPLICANT TRACKING SYSTEM (.env.example)
# =========================================================================
# Sao chép tệp này thành .env và điền các giá trị thực tế của bạn:
# cp .env.example .env

# 1. Cơ sở dữ liệu (PostgreSQL / Neon Serverless Database)
# Chuỗi kết nối có Connection Pool (PgBouncer)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.c-5.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Chuỗi kết nối trực tiếp không qua pooler (dành cho Prisma migrate / db push)
DATABASE_URL_UNPOOLED="postgresql://username:password@ep-sample.c-5.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. Khóa Google Gemini API (Lớp 2 AI Matching & Semantic Analysis)
# Đăng ký miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 3. Chuỗi bí mật mã hóa Cookie phiên đăng nhập (HMAC-SHA256)
# Khuyến nghị sinh chuỗi ngẫu nhiên 64 ký tự hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="your_random_32_bytes_hex_secret_here"

# 4. Địa chỉ ứng dụng (Public URL)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 5. Neon Object Storage (S3-Compatible Bucket `uploads`)
AWS_ACCESS_KEY_ID="your_neon_s3_access_key_id"
AWS_SECRET_ACCESS_KEY="your_neon_s3_secret_access_key"
AWS_ENDPOINT_URL_S3="https://your-branch-id.storage.c-5.ap-southeast-1.aws.neon.tech"
AWS_REGION="ap-southeast-1"

# 6. Bộ Ba Tự Động Hóa n8n Workflow (Mặc định chạy tự động ngầm 100%, tùy chọn nối server riêng)
# Workflow 1: Gửi Thư mời phỏng vấn & Tạo lịch Google Calendar
N8N_WEBHOOK_URL="http://localhost:5678/webhook/interview-schedule"
# Workflow 2: Bắn thông báo tức thì cho HR qua Telegram (@Rec_Hr_rBot) khi có CV mới
N8N_TELEGRAM_WEBHOOK_URL="http://localhost:5678/webhook/telegram-alert"
# Workflow 3: Bộ đệm hoãn 12 giờ gửi thư từ chối lịch sự & lưu trữ Kho Nhân Tài (BRL-05)
N8N_REJECTION_WEBHOOK_URL="http://localhost:5678/webhook/rejection-buffer"

# 7. Metadata Neon Cloud (Tùy chọn)
NEON_BRANCH=production
NEON_BRANCH_ID=your_neon_branch_id
NEON_FUNCTION_HOST_SUFFIX=.compute.c-5.ap-southeast-1.aws.neon.tech
